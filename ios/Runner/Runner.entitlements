<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app is the writer: it publishes the widget payload here and reads the
	     share extension's handoff from here. The share extension and the widget
	     declare the same group. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.karthik.everythingApp</string>
	</array>
</dict>
</plist>
