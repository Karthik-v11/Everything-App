<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The widget reads what the app published into this container. Same group
	     as Runner and the share extension. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.karthik.everythingApp</string>
	</array>
</dict>
</plist>
