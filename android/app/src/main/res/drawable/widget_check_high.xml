<?xml version="1.0" encoding="utf-8"?>
<!--
  An open high-priority task. The ring gains a washed fill, as Todoist's does: at
  14dp a colour change alone is easy to miss, and the fill is what makes the row
  findable in a glance rather than a read.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#33F5622D" />
    <stroke android:width="1.5dp" android:color="@color/widget_priority_high" />
    <size android:width="14dp" android:height="14dp" />
</shape>
