<?xml version="1.0" encoding="utf-8"?>
<!--
  The quick-add launcher (Requirement 13). Four routes into the app and no data,
  so it never goes stale and publishes nothing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:gravity="center">

    <TextView
        android:id="@+id/action_task"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:background="@drawable/widget_pill"
        android:gravity="center"
        android:text="@string/widget_task"
        android:contentDescription="@string/widget_add_task"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/action_expense"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:background="@drawable/widget_pill"
        android:gravity="center"
        android:text="@string/widget_expense"
        android:contentDescription="@string/widget_add_expense"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/action_ai"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:background="@drawable/widget_pill"
        android:gravity="center"
        android:text="@string/widget_ask"
        android:contentDescription="@string/widget_ask"
        android:textColor="@color/widget_accent"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/action_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="4dp"
        android:background="@drawable/widget_pill"
        android:gravity="center"
        android:text="@string/widget_search"
        android:contentDescription="@string/widget_search"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />
</LinearLayout>
